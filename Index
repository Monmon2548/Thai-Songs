        function checkAndStartQuiz() {
            const input = document.getElementById('player-name-input');
            playerName = input.value.trim();

            if (!playerName) {
                if (window.showToast) window.showToast("กรุณากรอกชื่อก่อนเริ่มเกม", "error");
                input.focus();
                return;
