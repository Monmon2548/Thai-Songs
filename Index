            const rankIcon = document.getElementById('rank-icon');
            const resultTopBar = document.getElementById('result-top-bar');

            if (isGameOver) {
                rankTitle.innerText = "💔 GAME OVER!";
                rankMsg.innerText = "พลังชีวิตของคุณหมดลงแล้ว! บันทึกสรุปความรู้ของคุณแล้วลองใหม่อีกครั้ง";
                rankBg.className = "w-24 h-24 md:w-28 md:h-28 rounded-full bg-slate-700 flex items-center justify-center mx-auto shadow-lg";
                rankIcon.className = "fa-solid fa-heart-crack text-white text-4xl md:text-5xl drop-shadow-md";
                resultTopBar.className = "absolute top-0 left-0 right-0 h-3 bg-red-600";
            } else {
                if (correctCount >= 10) {
                    if (typeof confetti === 'function') confetti({ particleCount: 100, spread: 80, origin: { y: 0.6 } });
                    rankTitle.innerText = "🏆 ปรมาจารย์เพลงพื้นบ้าน";
                    rankMsg.innerText = "สุดยอดความเชี่ยวชาญ! คุณทำคะแนนระดับท็อปของชั้นเรียน";
                    rankBg.className = "w-24 h-24 md:w-28 md:h-28 rounded-full bg-gradient-to-tr from-amber-400 to-yellow-300 flex items-center justify-center mx-auto shadow-lg animate-float";
                    rankIcon.className = "fa-solid fa-crown text-white text-4xl md:text-5xl drop-shadow-md";
                } else {
                    rankTitle.innerText = "🌟 นักปราชญ์เพลงพื้นบ้าน";
                    rankMsg.innerText = "เก่งมาก! คุณมีความรู้และความเข้าใจในวรรณกรรมเพลงพื้นบ้านอย่างถ่องแท้";
                    rankBg.className = "w-24 h-24 md:w-28 md:h-28 rounded-full bg-gradient-to-tr from-orange-400 to-amber-500 flex items-center justify-center mx-auto shadow-lg animate-float";
                    rankIcon.className = "fa-solid fa-award text-white text-4xl md:text-5xl drop-shadow-md";
                }
            }

            renderReviewSection();
            showScreen('result-screen');
        }

        function renderReviewSection() {
            const container = document.getElementById('answers-review-container');
            container.innerHTML = '';

            window.userAnswers.forEach((ans, idx) => {
                const q = questionsData[ans.questionIndex];
                const card = document.createElement('div');
                card.className = `p-3.5 rounded-xl border ${ans.isCorrect ? 'bg-emerald-50 border-emerald-200' : 'bg-red-50 border-red-200'} text-xs space-y-1.5`;

                let selectedText = ans.selectedOption >= 0 ? q.options[ans.selectedOption] : "หมดเวลา (ไม่ได้ตอบ)";

                card.innerHTML = `
                    <div class="flex items-start justify-between gap-2">
                        <span class="font-bold text-slate-800">${idx + 1}. ${q.question}</span>
                        <span class="px-2 py-0.5 rounded-full font-bold text-[10px] shrink-0 ${ans.isCorrect ? 'bg-emerald-200 text-emerald-900' : 'bg-red-200 text-red-900'}">
                            ${ans.isCorrect ? 'ถูกต้อง' : 'ตอบผิด'}
                        </span>
                    </div>
                    <p class="text-slate-600">
                        <strong>คำตอบของคุณ:</strong> ${selectedText}
                    </p>
                    ${!ans.isCorrect ? `<p class="text-emerald-900 font-semibold"><strong>เฉลยที่ถูกต้อง:</strong> ${q.options[q.correctIndex]}</p>` : ''}
                    <p class="text-slate-500 italic bg-white/80 p-2 rounded-lg border border-slate-100">
                        💡 ${q.explanation}
                    </p>
                `;
                container.appendChild(card);
            });
        }

        function toggleAnswerReview() {
            document.getElementById('answers-review-container').classList.toggle('hidden');
        }

        // MODAL CONTROLS
        function openKnowledgeModal() {
            playSound('click');
            document.getElementById('knowledge-modal').classList.remove('hidden');
        }

        function closeKnowledgeModal() {
            playSound('click');
            document.getElementById('knowledge-modal').classList.add('hidden');
        }

        function openLeaderboardModal() {
            playSound('click');
            document.getElementById('leaderboard-modal').classList.remove('hidden');
        }

        function closeLeaderboardModal() {
            playSound('click');
            document.getElementById('leaderboard-modal').classList.add('hidden');
        }

        // Expose functions globally for inline HTML handlers
        window.toggleSound = toggleSound;
        window.showScreen = showScreen;
        window.checkAndStartQuiz = checkAndStartQuiz;
        window.selectOption = selectOption;
        window.useLifeline5050 = useLifeline5050;
        window.useLifelineFreeze = useLifelineFreeze;
        window.nextQuestion = nextQuestion;
        window.toggleAnswerReview = toggleAnswerReview;
        window.openKnowledgeModal = openKnowledgeModal;
        window.closeKnowledgeModal = closeKnowledgeModal;
        window.openLeaderboardModal = openLeaderboardModal;
        window.closeLeaderboardModal = closeLeaderboardModal;

        window.onclick = function(event) {
            if (event.target === document.getElementById('knowledge-modal')) closeKnowledgeModal();
            if (event.target === document.getElementById('leaderboard-modal')) closeLeaderboardModal();
        };
    </script>
</body>
</html>
