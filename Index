        function startQuiz() {
            currentQuestionIndex = 0;
            window.score = 0;
            lives = 3;
            comboCount = 0;
            window.maxCombo = 1;
            window.userAnswers = [];
            usedLifeline5050 = false;
            usedLifelineFreeze = false;
            
            updateLifelinesUI();
            updateLivesUI();
            showScreen('quiz-screen');
            renderQuestion();
