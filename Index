        function triggerCardShake() {
            const card = document.getElementById('quiz-card');
            card.classList.add('animate-shake');
            setTimeout(() => card.classList.remove('animate-shake'), 450);
        }

        function useLifeline5050() {
            if (usedLifeline5050 || isAnswerSubmitted) return;
            usedLifeline5050 = true;
            updateLifelinesUI();

            const q = questionsData[currentQuestionIndex];
            const incorrectIndexes = [0, 1, 2, 3].filter(i => i !== q.correctIndex);
            incorrectIndexes.sort(() => Math.random() - 0.5);
            const toRemove = incorrectIndexes.slice(0, 2);

            toRemove.forEach(idx => {
                const btn = document.getElementById(`option-btn-${idx}`);
                if (btn) {
                    btn.disabled = true;
                    btn.style.opacity = '0.25';
                    btn.style.pointerEvents = 'none';
                    btn.querySelector('.option-state-icon').className = 'fa-solid fa-ban text-slate-300';
                }
            });
        }

