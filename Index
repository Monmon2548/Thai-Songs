        function startQuestionTimer() {
            clearInterval(timerInterval);
            timeRemaining = QUESTION_TIME_LIMIT;
            isTimerFrozen = false;
            updateTimerUI();

            timerInterval = setInterval(() => {
                if (isTimerFrozen) return;

                timeRemaining--;
                updateTimerUI();

                if (timeRemaining <= 0) {
                    clearInterval(timerInterval);
                    handleTimeout();
                }
            }, 1000);
        }

        function updateTimerUI() {
            const timerText = document.getElementById('timer-text');
            const timerBar = document.getElementById('timer-bar');

            timerText.innerText = `⏱️ ${timeRemaining}s`;
            const pct = (timeRemaining / QUESTION_TIME_LIMIT) * 100;
            timerBar.style.width = `${Math.max(0, pct)}%`;

            if (timeRemaining <= 5) {
                timerText.className = "font-mono text-red-600 font-extrabold animate-pulse";
                timerBar.className = "bg-gradient-to-r from-red-500 to-rose-600 h-full rounded-full transition-all duration-300 w-full";
            } else {
                timerText.className = "font-mono text-orange-600 font-extrabold";
                timerBar.className = "bg-gradient-to-r from-emerald-500 via-amber-500 to-orange-500 h-full rounded-full transition-all duration-300 w-full";
            }
        }

        function updateLivesUI() {
            const container = document.getElementById('lives-container');
            container.innerHTML = '';
            for (let i = 0; i < 3; i++) {
                const heart = document.createElement('i');
                if (i < lives) {
                    heart.className = `fa-solid fa-heart text-red-500 text-sm ${lives === 1 ? 'animate-heart-danger' : ''}`;
                } else {
                    heart.className = "fa-regular fa-heart text-slate-300 text-sm";
                }
                container.appendChild(heart);
            }
        }

        function updateComboUI() {
            const comboBadge = document.getElementById('combo-badge');
            const comboText = document.getElementById('combo-multiplier-text');

            if (comboCount >= 2) {
                let multiplier = comboCount >= 4 ? 3.0 : comboCount === 3 ? 2.0 : 1.5;
                comboText.innerText = `COMBO x${multiplier}!`;
                comboBadge.classList.remove('hidden');
            } else {
                comboBadge.classList.add('hidden');
            }
        }

        function updateLifelinesUI() {
            document.getElementById('lifeline-5050').disabled = usedLifeline5050;
            document.getElementById('lifeline-freeze').disabled = usedLifelineFreeze;
        }

        function renderQuestion() {
            isAnswerSubmitted = false;
            const q = questionsData[currentQuestionIndex];

            document.getElementById('question-counter').innerText = `ข้อ ${currentQuestionIndex + 1}/${questionsData.length}`;
            document.getElementById('current-score').innerText = window.score;
            updateComboUI();

            document.getElementById('question-category').innerText = `หมวด: ${q.category}`;
            document.getElementById('question-text').innerText = `${currentQuestionIndex + 1}. ${q.question}`;
            document.getElementById('explanation-box').classList.add('hidden');

            const container = document.getElementById('options-container');
            container.innerHTML = '';

            q.options.forEach((optText, idx) => {
                const btn = document.createElement('button');
                btn.className = `option-btn w-full p-4 rounded-2xl text-left border-2 border-slate-200 bg-white hover:border-amber-400 hover:bg-amber-50/50 text-slate-800 font-semibold text-sm md:text-base flex items-center justify-between transition-all group`;
                btn.id = `option-btn-${idx}`;
                btn.onclick = () => selectOption(idx);

                btn.innerHTML = `
                    <div class="flex items-center gap-3">
                        <span class="w-8 h-8 rounded-xl bg-slate-100 group-hover:bg-amber-200 text-slate-700 group-hover:text-amber-900 font-extrabold text-xs flex items-center justify-center shrink-0 border border-slate-200 transition">
                            ${String.fromCharCode(65 + idx)}
                        </span>
                        <span>${optText}</span>
                    </div>
                    <i class="fa-regular fa-circle text-slate-300 group-hover:text-amber-500 text-lg option-state-icon"></i>
                `;
                container.appendChild(btn);
            });

            startQuestionTimer();
        }

        function selectOption(selectedIndex) {
            if (isAnswerSubmitted) return;
            isAnswerSubmitted = true;
            clearInterval(timerInterval);

            const q = questionsData[currentQuestionIndex];
            const isCorrect = (selectedIndex === q.correctIndex);

            if (isCorrect) {
                comboCount++;
                if (comboCount > window.maxCombo) window.maxCombo = comboCount;

                let multiplier = comboCount >= 4 ? 3.0 : comboCount === 3 ? 2.0 : comboCount === 2 ? 1.5 : 1.0;
                let speedBonus = timeRemaining * 10;
                let pointsGained = Math.round((100 + speedBonus) * multiplier);

                window.score += pointsGained;
                playSound(comboCount >= 2 ? 'combo' : 'correct');
            } else {
                comboCount = 0;
                lives--;
                playSound('wrong');
                triggerCardShake();
            }

            window.userAnswers.push({
                questionIndex: currentQuestionIndex,
                selectedOption: selectedIndex,
                isCorrect: isCorrect
            });

            updateLivesUI();
            updateComboUI();
            document.getElementById('current-score').innerText = window.score;
            highlightOptions(selectedIndex, q.correctIndex);
            showExplanation(isCorrect, q);

            if (lives <= 0) {
                document.getElementById('next-btn').innerHTML = `<span>จบเกม (สรุปผล)</span> <i class="fa-solid fa-flag-checkered"></i>`;
            }
        }

        function handleTimeout() {
            if (isAnswerSubmitted) return;
            isAnswerSubmitted = true;

            const q = questionsData[currentQuestionIndex];
            comboCount = 0;
            lives--;
            playSound('wrong');
            triggerCardShake();

            window.userAnswers.push({
                questionIndex: currentQuestionIndex,
                selectedOption: -1,
                isCorrect: false
            });

            updateLivesUI();
            updateComboUI();
            highlightOptions(-1, q.correctIndex);

            const expBox = document.getElementById('explanation-box');
            const expIcon = document.getElementById('explanation-icon');
            const expTitle = document.getElementById('explanation-title');
            const expText = document.getElementById('explanation-text');

            expBox.classList.remove('hidden');
            expBox.className = "mt-5 p-4 rounded-2xl border bg-rose-50 border-rose-200 text-rose-950 animate-fadeIn";
            expIcon.className = "w-8 h-8 rounded-full bg-rose-600 text-white flex items-center justify-center shrink-0 mt-0.5";
            expIcon.innerHTML = `<i class="fa-solid fa-clock"></i>`;
            expTitle.innerText = `หมดเวลา! (เฉลยข้อ ${String.fromCharCode(65 + q.correctIndex)})`;
            expTitle.className = "font-bold text-sm md:text-base text-rose-900";
            expText.innerText = q.explanation;

            if (lives <= 0) {
                document.getElementById('next-btn').innerHTML = `<span>จบเกม (สรุปผล)</span> <i class="fa-solid fa-flag-checkered"></i>`;
            }
        }

        function highlightOptions(selectedIndex, correctIndex) {
            const optionBtns = document.querySelectorAll('.option-btn');
            optionBtns.forEach((btn, idx) => {
                btn.disabled = true;
                const icon = btn.querySelector('.option-state-icon');

