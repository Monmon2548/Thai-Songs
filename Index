            document.getElementById('final-score').innerText = window.score;
            document.getElementById('final-correct').innerText = `${correctCount}/${totalQuestions}`;
            document.getElementById('final-combo').innerText = `x${window.maxCombo >= 2 ? (window.maxCombo >= 4 ? 3.0 : window.maxCombo === 3 ? 2.0 : 1.5) : 1}`;

