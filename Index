            if (usedLifelineFreeze || isAnswerSubmitted) return;
            usedLifelineFreeze = true;
            updateLifelinesUI();

            timeRemaining += 10;
            isTimerFrozen = true;
            updateTimerUI();

            setTimeout(() => {
                isTimerFrozen = false;
            }, 5000);
