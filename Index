                } else if (idx === selectedIndex) {
                    btn.className = "option-btn w-full p-4 rounded-2xl text-left border-2 border-red-500 bg-red-50 text-red-950 font-bold text-sm md:text-base flex items-center justify-between shadow-sm";
                    icon.className = "fa-solid fa-circle-xmark text-red-600 text-xl";
                } else {
                    btn.className = "option-btn w-full p-4 rounded-2xl text-left border-2 border-slate-100 bg-white/60 text-slate-400 font-normal text-sm md:text-base flex items-center justify-between opacity-50";
